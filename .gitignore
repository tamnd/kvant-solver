# build output. The leading slash matters: a bare kvant here would also ignore
# cmd/kvant, which is the one directory that must never be ignored.
/dist/
/bin/
/kvant

# working data, none of it belongs in git
/work/
/pdf/
/images/
/scans/
*.duckdb
*.duckdb.wal

# local config and secrets
.env
routes.json
*.pem

# editors and OS
.DS_Store
.idea/
.vscode/
